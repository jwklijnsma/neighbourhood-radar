# Map centre (default: Heerenveen) and the area the backend fetches for.
OL_CENTER_LAT=52.9594
OL_CENTER_LON=5.9189
OL_REGION_RADIUS_KM=60
OL_MAX_QUERY_RADIUS_KM=100

# P2000 veiligheidsregio codes: 1 Groningen, 2 Fryslân, 3 Drenthe (empty = whole country)
OL_P2000_REGIOS=1,2,3

# Optional keys -------------------------------------------------------------
# NS disruptions: free key at https://apiportal.ns.nl (subscribe to product "Ns-App")
OL_NS_API_KEY=
# Webcams: free key at https://api.windy.com/keys
OL_WINDY_API_KEY=
# Aircraft: auto | adsblol | fr24 | readsb | opensky | airplaneslive
OL_AIRCRAFT_SOURCE=auto
# Flightradar24 API token (paid subscription, fr24api.flightradar24.com); full or light
OL_FR24_API_TOKEN=
OL_FR24_ENDPOINT=full
# Your own ADS-B receiver, e.g. http://pi/tar1090/data/aircraft.json
OL_READSB_URL=
# Seconds between aircraft refreshes (0 = provider default) and trail length in minutes
OL_AIRCRAFT_TTL=0
OL_AIRCRAFT_TRAIL_MINUTES=10
# OpenSky OAuth2 API client (account page on opensky-network.org); raises 400 -> 4000 credits/day
OL_OPENSKY_CLIENT_ID=
OL_OPENSKY_CLIENT_SECRET=

# Only if NDW publishes DRIP sign locations in a separate file
OL_NDW_DRIP_TABLE_URL=

# Satellites: CelesTrak groups and minimum elevation above your horizon
OL_CELESTRAK_GROUPS=stations,visual
OL_SAT_MIN_ELEVATION_DEG=10

# Turn layers off entirely:
# p2000,traffic,bridges,roadworks,drips,busalerts,transit,trains,webcams,charging,safety,
# weather,water,air,aircraft,airports,satellites,quakes
OL_DISABLED_SOURCES=
